# --- Runtime ---
ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./reviewpilot.db
LOG_LEVEL=INFO

# --- GitHub App ---
# Users sign in with the seeded accounts below; installing the App links their GitHub identity.
# Without these values users can sign in, but the dashboard stays on "Install the GitHub App".
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_URL=https://api.github.com

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
# Gemini 3.5 Flash-Lite allows up to 65536 output tokens.
GEMINI_MAX_OUTPUT_TOKENS=8192
# Input context window of GEMINI_MODEL; bounds the size of one diff batch.
GEMINI_CONTEXT_TOKENS=1048576

# --- Auth/Security ---
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=8
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Seeded sign-in accounts, created or updated on startup. Outside production, empty passwords default to
# dev12345 / admin12345. In production, an account without a password is not created.
SEED_DEV_USERNAME=dev
SEED_DEV_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# --- Review engine ---
# 0 = no hard cut. Positive values cut the diff before batching.
MAX_DIFF_CHARS=0
# Large diffs are split into batches of ~DIFF_BATCH_TOKENS, reviewed concurrently and merged into one review.
DIFF_BATCH_TOKENS=100000
# Above this many batches the batch size grows (up to the context window) instead of dropping files.
MAX_DIFF_BATCHES=50
DIFF_BATCH_CONCURRENCY=4
GEMINI_CACHE_TTL_SECONDS=86400
MAX_COMMENT_CHARS=65000
INSTALLATION_TOKEN_TTL_SECONDS=3000

# --- Worker ---
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1.0
JOB_MAX_ATTEMPTS=3
# Batched reviews of very large diffs need several LLM calls.
JOB_TIMEOUT_SECONDS=600
