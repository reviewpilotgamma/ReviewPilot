# --- Runtime ---
ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./reviewpilot.db
LOG_LEVEL=INFO

# --- GitHub App ---
# Leave the GitHub values empty to use local mode (development only):
# the landing page shows "Continue locally", and reviews are saved without posting to GitHub.
# A review still needs GEMINI_API_KEY. From backend/:
#   python -m scripts.run_review --repo local/manual --pr 1 --title "Add retries" --diff change.diff
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_URL=https://api.github.com

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192

# --- Auth/Security ---
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=8
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
ADMIN_GITHUB_LOGINS=

# --- Review engine ---
MAX_DIFF_CHARS=120000
MAX_COMMENT_CHARS=65000
INSTALLATION_TOKEN_TTL_SECONDS=3000

# --- Worker ---
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1.0
JOB_MAX_ATTEMPTS=3
